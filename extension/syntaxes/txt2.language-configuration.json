{
  "brackets": [
    ["((", "))"],
    ["{{", "}}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{{", "close": "}}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" }
  ],
  "surroundingPairs": [
    ["*", "*"],
    ["_", "_"],
    ["+", "+"],
    ["!", "!"],
    ["?", "?"],
    ["[", "]"],
    ["(", ")"]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*(\\(\\(\\S|>>(\\s|$)|```|\"\"$|\\{\\{$)",
      "end": "^\\s*(\\)\\)|<<|```|\"\"|\\}\\})\\s*$"
    }
  },
  "wordPattern": "[\\p{L}\\p{N}_]+"
}
