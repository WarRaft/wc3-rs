{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "JASS",
    "scopeName": "source.jass",
    "patterns": [
        {
            "include": "#zinc-block"
        },
        {
            "include": "#comment"
        },
        {
            "include": "#string"
        }
    ],
    "repository": {
        "comment": {
            "name": "comment.line.double-slash.jass",
            "match": "//.*$"
        },
        "string": {
            "name": "string.quoted.single.jass",
            "begin": "'",
            "end": "'|$",
            "patterns": [
                {
                    "name": "constant.character.escape.jass",
                    "match": "\\\\."
                }
            ]
        },
        "zinc-block": {
            "name": "meta.embedded.block.zinc",
            "begin": "^\\s*(//!\\s*zinc)\\s*$",
            "beginCaptures": {
                "1": {
                    "name": "keyword.control.directive.zinc.jass"
                }
            },
            "end": "^\\s*(//!\\s*endzinc)\\s*$",
            "endCaptures": {
                "1": {
                    "name": "keyword.control.directive.zinc.jass"
                }
            },
            "contentName": "source.zinc",
            "patterns": [
                {
                    "include": "source.zinc"
                }
            ]
        }
    }
}
