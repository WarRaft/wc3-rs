{
  "name": "wc3",
  "displayName": "WC3",
  "description": "Warcraft III language support for VS Code — JASS/vJASS, Zinc, Lua, AngelScript and BNI: semantic highlighting, live diagnostics and wc3.bni projects; maps as folders and a BLP texture viewer; object data (.w3a .w3u ...), cameras (.w3c), regions (.w3r), sounds (.w3s), the terrain's header (.w3e), map info (.w3i) and the custom script (.wct) as editable text; pathing maps (.wpm) as a picture.",
  "version": "0.0.7",
  "publisher": "WarRaft",
  "icon": "images/logo.png",
  "license": "CC0-1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/WarRaft/wc3-rs"
  },
  "engines": {
    "vscode": "^1.111.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onFileSystem:wc3obj",
    "onFileSystem:wc3map",
    "onMcpCollection:wc3"
  ],
  "contributes": {
    "commands": [
      {
        "command": "wc3.revealFolder",
        "title": "WC3: Reveal Folder"
      },
      {
        "command": "wc3.maps.refresh",
        "title": "Refresh",
        "category": "WC3",
        "icon": "$(refresh)"
      },
      {
        "command": "wc3.maps.reveal",
        "title": "Reveal in Explorer",
        "category": "WC3"
      },
      {
        "command": "wc3.openMapAsFolder",
        "title": "Open Map as Folder",
        "category": "WC3",
        "icon": "$(folder-opened)"
      },
      {
        "command": "wc3.slk.openTable",
        "title": "Open as Table",
        "category": "WC3",
        "icon": "$(table)"
      },
      {
        "command": "wc3.slk.openText",
        "title": "Open as Text",
        "category": "WC3",
        "icon": "$(go-to-file)"
      },
      {
        "command": "wc3.trg.openVisual",
        "title": "Open as Trigger",
        "category": "WC3",
        "icon": "$(symbol-event)"
      },
      {
        "command": "wc3.trg.openText",
        "title": "Open as Text",
        "category": "WC3",
        "icon": "$(go-to-file)"
      },
      {
        "command": "wc3.trg.showJass",
        "title": "Show JASS",
        "category": "WC3",
        "icon": "$(code)"
      },
      {
        "command": "wc3.wtg.extract",
        "title": "Extract Triggers…",
        "category": "WC3",
        "icon": "$(file-symlink-directory)"
      },
      {
        "command": "wc3.txt2.preview",
        "title": "Open Preview",
        "category": "txt2",
        "icon": "$(open-preview)"
      },
      {
        "command": "wc3.txt2.previewSide",
        "title": "Open Preview to the Side",
        "category": "txt2",
        "icon": "$(open-preview)"
      }
    ],
    "customEditors": [
      {
        "viewType": "wc3.map",
        "displayName": "Warcraft III Map",
        "selector": [
          {
            "filenamePattern": "*.w3x"
          },
          {
