{
  "name": "wc3",
  "displayName": "WC3",
  "description": "Warcraft III language support for VS Code — JASS/vJASS, Zinc, Lua, AngelScript and BNI: semantic highlighting, live diagnostics and wc3.bni projects.",
  "version": "0.0.2",
  "publisher": "WarRaft",
  "icon": "images/logo.png",
  "license": "CC0-1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/WarRaft/wc3-rs"
  },
  "engines": {
    "vscode": "^1.111.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "wc3.revealFolder",
        "title": "WC3: Reveal Folder"
      },
      {
        "command": "wc3.maps.refresh",
        "title": "Refresh",
        "category": "WC3",
        "icon": "$(refresh)"
      },
      {
        "command": "wc3.maps.reveal",
        "title": "Reveal in Explorer",
        "category": "WC3"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "wc3.maps",
          "name": "WC3 Maps",
          "icon": "$(package)"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "wc3.revealFolder",
          "when": "false"
        },
        {
          "command": "wc3.maps.reveal",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "wc3.maps.refresh",
          "when": "view == wc3.maps",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "wc3.maps.reveal",
          "when": "view == wc3.maps && viewItem == wc3.map"
        }
      ]
    },
    "languages": [
      {
        "id": "jass",
        "aliases": [
          "JASS"
        ],
        "extensions": [
          ".j",
          ".pld",
          ".ai"
        ],
        "icon": {
          "light": "./icons/jass.svg",
          "dark": "./icons/jass.svg"
        },
        "configuration": "./syntaxes/jass.language-configuration.json"
      },
      {
        "id": "zinc",
        "aliases": [
          "Zinc"
        ],
        "extensions": [
          ".zn"
        ],
        "icon": {
          "light": "./icons/zinc.svg",
          "dark": "./icons/zinc.svg"
        },
        "configuration": "./syntaxes/zinc.language-configuration.json"
      },
      {
        "id": "lua",
        "icon": {
          "light": "./icons/lua.svg",
          "dark": "./icons/lua.svg"
        }
      },
      {
        "id": "angelscript",
        "aliases": [
          "AngelScript"
        ],
        "extensions": [
          ".as",
          ".angelscript"
        ],
        "icon": {
          "light": "./icons/as.svg",
          "dark": "./icons/as.svg"
        },
        "configuration": "./syntaxes/angelscript.language-configuration.json"
      },
      {
        "id": "bni",
        "aliases": [
          "BNI"
        ],
        "extensions": [
          ".bni"
        ],
        "filenames": [
          "wc3.bni"
        ],
        "icon": {
          "light": "./icons/bni.svg",
          "dark": "./icons/bni.svg"
        },
        "configuration": "./syntaxes/bni.language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jass",
        "scopeName": "source.jass",
        "path": "./syntaxes/jass.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.zinc": "zinc"
        }
      },
      {
        "language": "zinc",
        "scopeName": "source.zinc",
        "path": "./syntaxes/zinc.tmLanguage.json"
      },
      {
        "language": "angelscript",
        "scopeName": "source.angelscript",
        "path": "./syntaxes/angelscript.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "jass",
        "scopes": {
          "comment": [
            "comment"
          ],
          "string": [
            "string"
          ],
          "keyword": [
            "keyword.control"
          ],
          "number": [
            "constant.numeric"
          ],
          "regexp": [
            "string.regexp"
          ],
          "operator": [
            "keyword.operator"
          ],
          "decorator": [
            "entity.name.decorator"
          ],
          "label": [
            "entity.name.label"
          ],
          "typeParameter": [
            "entity.name.type.parameter"
          ]
        }
      },
      {
        "language": "zinc",
        "scopes": {
          "comment": [
            "comment"
          ],
          "string": [
            "string"
          ],
          "keyword": [
            "keyword.control"
          ],
          "number": [
            "constant.numeric"
          ],
          "regexp": [
            "string.regexp"
          ],
          "operator": [
            "keyword.operator"
          ],
          "decorator": [
            "entity.name.decorator"
          ],
          "label": [
            "entity.name.label"
          ],
          "typeParameter": [
            "entity.name.type.parameter"
          ]
        }
      },
      {
        "language": "lua",
        "scopes": {
          "comment": [
            "comment"
          ],
          "string": [
            "string"
          ],
          "keyword": [
            "keyword.control"
          ],
          "number": [
            "constant.numeric"
          ],
          "regexp": [
            "string.regexp"
          ],
          "operator": [
            "keyword.operator"
          ],
          "decorator": [
            "entity.name.decorator"
          ],
          "label": [
            "entity.name.label"
          ],
          "typeParameter": [
            "entity.name.type.parameter"
          ]
        }
      },
      {
        "language": "angelscript",
        "scopes": {
          "comment": [
            "comment"
          ],
          "string": [
            "string"
          ],
          "keyword": [
            "keyword.control"
          ],
          "number": [
            "constant.numeric"
          ],
          "regexp": [
            "string.regexp"
          ],
          "operator": [
            "keyword.operator"
          ],
          "decorator": [
            "entity.name.decorator"
          ],
          "label": [
            "entity.name.label"
          ],
          "typeParameter": [
            "entity.name.type.parameter"
          ]
        }
      },
      {
        "language": "bni",
        "scopes": {
          "comment": [
            "comment"
          ],
          "string": [
            "string"
          ],
          "keyword": [
            "keyword.control"
          ],
          "number": [
            "constant.numeric"
          ],
          "regexp": [
            "string.regexp"
          ],
          "operator": [
            "keyword.operator"
          ],
          "decorator": [
            "entity.name.decorator"
          ],
          "label": [
            "entity.name.label"
          ],
          "typeParameter": [
            "entity.name.type.parameter"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[jass]": {
        "editor.semanticHighlighting.enabled": true
      },
      "[zinc]": {
        "editor.semanticHighlighting.enabled": true
      },
      "[lua]": {
        "editor.semanticHighlighting.enabled": true
      },
      "[angelscript]": {
        "editor.semanticHighlighting.enabled": true
      },
      "[bni]": {
        "editor.semanticHighlighting.enabled": true
      }
    }
  }
}
