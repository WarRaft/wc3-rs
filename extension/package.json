{
  "name": "wc3",
  "displayName": "WC3",
  "description": "Warcraft III language support for VS Code — JASS/vJASS, Zinc, Lua, AngelScript and BNI: semantic highlighting, live diagnostics and wc3.bni projects; maps as folders and a BLP texture viewer; object data (.w3a .w3u ...) as editable text.",
  "version": "0.0.3",
  "publisher": "WarRaft",
  "icon": "images/logo.png",
  "license": "CC0-1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/WarRaft/wc3-rs"
  },
  "engines": {
    "vscode": "^1.111.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onFileSystem:wc3obj",
    "onFileSystem:wc3map"
  ],
  "contributes": {
    "commands": [
      {
        "command": "wc3.revealFolder",
        "title": "WC3: Reveal Folder"
      },
      {
        "command": "wc3.maps.refresh",
        "title": "Refresh",
        "category": "WC3",
        "icon": "$(refresh)"
      },
      {
        "command": "wc3.maps.reveal",
        "title": "Reveal in Explorer",
        "category": "WC3"
      },
      {
        "command": "wc3.openMapAsFolder",
        "title": "Open Map as Folder",
        "category": "WC3",
        "icon": "$(folder-opened)"
      },
      {
        "command": "wc3.slk.openTable",
        "title": "Open as Table",
        "category": "WC3",
        "icon": "$(table)"
      },
      {
        "command": "wc3.slk.openText",
        "title": "Open as Text",
        "category": "WC3",
        "icon": "$(go-to-file)"
      }
    ],
    "customEditors": [
      {
        "viewType": "wc3.map",
        "displayName": "Warcraft III Map",
        "selector": [
          {
            "filenamePattern": "*.w3x"
          },
          {
            "filenamePattern": "*.w3m"
          },
          {
            "filenamePattern": "*.W3X"
          },
          {
            "filenamePattern": "*.W3M"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "wc3.blp",
        "displayName": "BLP Texture",
        "selector": [
          {
            "filenamePattern": "*.blp"
          },
          {
            "filenamePattern": "*.BLP"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "wc3.objects",
        "displayName": "Object Data as Text",
        "selector": [
          {
            "filenamePattern": "*.w3a"
          },
          {
            "filenamePattern": "*.w3b"
          },
          {
            "filenamePattern": "*.w3d"
          },
          {
            "filenamePattern": "*.w3h"
          },
          {
            "filenamePattern": "*.w3q"
          },
          {
            "filenamePattern": "*.w3t"
          },
          {
            "filenamePattern": "*.w3u"
          },
          {
            "filenamePattern": "*.W3A"
          },
          {
            "filenamePattern": "*.W3B"
          },
          {
            "filenamePattern": "*.W3D"
          },
          {
            "filenamePattern": "*.W3H"
          },
          {
            "filenamePattern": "*.W3Q"
          },
          {
            "filenamePattern": "*.W3T"
          },
          {
            "filenamePattern": "*.W3U"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "wc3.slkTable",
        "displayName": "SLK Table",
        "selector": [
          {
            "filenamePattern": "*.slk"
          },
          {
            "filenamePattern": "*.SLK"
          }
        ],
        "priority": "option"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "wc3.maps",
          "name": "WC3 Maps",
          "icon": "./icons/w3x.svg"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "wc3.revealFolder",
          "when": "false"
        },
        {
          "command": "wc3.maps.reveal",
          "when": "false"
        },
        {
          "command": "wc3.slk.openTable",
          "when": "editorLangId == slk || activeCustomEditorId == wc3.slkTable"
        },
        {
          "command": "wc3.slk.openText",
          "when": "activeCustomEditorId == wc3.slkTable"
        }
      ],
      "view/title": [
        {
          "command": "wc3.maps.refresh",
          "when": "view == wc3.maps",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "wc3.openMapAsFolder",
          "when": "view == wc3.maps && viewItem == wc3.map",
          "group": "inline"
        },
        {
          "command": "wc3.maps.reveal",
          "when": "view == wc3.maps && viewItem == wc3.map"
        }
      ],
      "explorer/context": [
        {
          "command": "wc3.openMapAsFolder",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.(w3x|w3m)$/i",
          "group": "navigation"
        },
        {
          "command": "wc3.slk.openTable",
          "when": "resourceExtname =~ /^\\.slk$/i",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "wc3.slk.openTable",
          "when": "editorLangId == slk && !activeCustomEditorId",
          "group": "navigation"
        },
        {
          "command": "wc3.slk.openText",
          "when": "activeCustomEditorId == wc3.slkTable",
          "group": "navigation"
        }
      ]
    },
