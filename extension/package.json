    "views": {
      "explorer": [
        {
          "id": "wc3.maps",
          "name": "WC3 Maps",
          "icon": "./icons/w3x.svg"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "wc3.revealFolder",
          "when": "false"
        },
        {
          "command": "wc3.maps.reveal",
          "when": "false"
        },
        {
          "command": "wc3.slk.openTable",
          "when": "editorLangId == slk || activeCustomEditorId == wc3.slkTable"
        },
        {
          "command": "wc3.slk.openText",
          "when": "activeCustomEditorId == wc3.slkTable"
        },
        {
          "command": "wc3.txt2.preview",
          "when": "editorLangId == txt2"
        },
        {
          "command": "wc3.txt2.previewSide",
          "when": "editorLangId == txt2"
        },
        {
          "command": "wc3.trg.openVisual",
          "when": "editorLangId == trg && !activeCustomEditorId"
        },
        {
          "command": "wc3.trg.openText",
          "when": "activeCustomEditorId == wc3.trigger"
        },
        {
          "command": "wc3.wtg.extract",
          "when": "editorLangId == wtg"
        },
        {
          "command": "wc3.trg.showJass",
          "when": "editorLangId == trg || activeCustomEditorId == wc3.trigger"
        }
      ],
      "view/title": [
        {
          "command": "wc3.maps.refresh",
          "when": "view == wc3.maps",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "wc3.openMapAsFolder",
          "when": "view == wc3.maps && viewItem == wc3.map",
          "group": "inline"
        },
        {
          "command": "wc3.maps.reveal",
          "when": "view == wc3.maps && viewItem == wc3.map"
        }
      ],
      "explorer/context": [
        {
          "command": "wc3.openMapAsFolder",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.(w3x|w3m)$/i",
          "group": "navigation"
        },
        {
          "command": "wc3.slk.openTable",
          "when": "resourceExtname =~ /^\\.slk$/i",
          "group": "navigation"
        },
        {
          "command": "wc3.txt2.preview",
          "when": "resourceExtname == .txt2",
          "group": "navigation"
        },
        {
          "command": "wc3.trg.openVisual",
          "when": "resourceExtname =~ /^\\.trg$/i",
          "group": "navigation"
        },
        {
          "command": "wc3.wtg.extract",
          "when": "resourceExtname =~ /^\\.wtg$/i",
          "group": "navigation"
        },
        {
          "command": "wc3.trg.showJass",
          "when": "resourceExtname =~ /^\\.trg$/i",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "wc3.slk.openTable",
          "when": "editorLangId == slk && !activeCustomEditorId",
          "group": "navigation"
        },
        {
          "command": "wc3.slk.openText",
          "when": "activeCustomEditorId == wc3.slkTable",
          "group": "navigation"
        },
        {
          "command": "wc3.txt2.previewSide",
          "when": "editorLangId == txt2",
          "group": "navigation"
        },
        {
          "command": "wc3.trg.openVisual",
          "when": "editorLangId == trg && !activeCustomEditorId",
          "group": "navigation"
        },
        {
          "command": "wc3.trg.openText",
          "when": "activeCustomEditorId == wc3.trigger",
          "group": "navigation"
        },
        {
          "command": "wc3.wtg.extract",
          "when": "editorLangId == wtg",
          "group": "navigation"
        },
        {
          "command": "wc3.trg.showJass",
          "when": "editorLangId == trg || activeCustomEditorId == wc3.trigger",
          "group": "navigation"
        }
      ]
    },
